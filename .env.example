# Beatster backend configuration — every knob, with its default.
# All settings are plain env vars; for local use copy this to `.env` and run
#   uvicorn app.main:app --env-file ../.env
# (uvicorn's --env-file support ships with fastapi[standard] — no extra dep.)

# ---- storage ---------------------------------------------------------------
# One base directory for ALL mutable state: catalog cache, community songs,
# stats DB, room snapshots. The individual overrides below win over it.
#BEATSTER_DATA_DIR=~/.cache/beatster

# Pre-built seed-catalog cache (build with tools/build_cache.py — the server
# never live-resolves the catalog at startup; iTunes rate limits).
#BEATSTER_CATALOG_CACHE=<data dir>/catalog.json

# SQLite stats DB (finished games, placements, activity feed).
#BEATSTER_DB=<data dir>/beatster.db

# Room checkpoint snapshots (games survive restarts/deploys).
#BEATSTER_ROOMS_DIR=<data dir>/rooms

# ---- serving ---------------------------------------------------------------
# Point at the built frontend (frontend/dist) to serve everything from the
# one FastAPI process — the self-host mode. Leave unset when a reverse proxy
# (nginx) serves the static files instead.
#BEATSTER_STATIC_DIR=

# ---- optional --------------------------------------------------------------
# Enables GET /api/owner/summary?token=… (private usage stats). Unset = off.
#BEATSTER_OWNER_TOKEN=

# Contact (email/URL) for the MusicBrainz User-Agent used by
# tools/check_years.py — MB's API policy requires one.
#BEATSTER_MB_CONTACT=
